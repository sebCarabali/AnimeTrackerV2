# =====================================================================
# .gitignore — AnimeTracker monorepo
# Combina exclusiones para .NET, Node.js y herramientas del workspace
# =====================================================================

# ─── .NET / C# ────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.nupkg
*.snupkg
TestResults/
coverage-reports/

# ─── Node.js / pnpm ───────────────────────────────────────────────
node_modules/
dist/
.cache/
.turbo/
.nx/cache/
*.tsbuildinfo

# ─── Cobertura de código ──────────────────────────────────────────
coverage/
lcov.info
*.lcov
.nyc_output/

# ─── Variables de entorno y secretos ─────────────────────────────
.env
.env.*
!.env.example

# ─── IDEs y editores ─────────────────────────────────────────────
.idea/
*.iml
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ─── Sistemas operativos ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/

# ─── Docker ──────────────────────────────────────────────────────
.docker/

# ─── Builds de la extensión ──────────────────────────────────────
apps/extension/dist/
apps/extension/build/
node_modules

# ─── Cliente generado del BFF (HU-00.03, no se edita a mano) ─────
apps/bff/src/generated/

# ─── Cliente generado de la SPA (HU-00.04, no se edita a mano) ───
apps/spa/src/app/core/api/generated/

# ─── Caché del Angular CLI ────────────────────────────────────────
.angular/

# Test results
TestResults*