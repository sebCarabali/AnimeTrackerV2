# =============================================================================
# AnimeTracker — Template de variables de entorno
# Copia a .env y actualiza según tu entorno (local, staging, producción)
# =============================================================================

# BFF (apps/bff)
# URL del núcleo .NET (backend core)
CORE_BASE_URL=http://localhost:5000

# Puerto de escucha del BFF
PORT=3000

# Entorno (development, staging, production)
NODE_ENV=development
